DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Without it mia runs normally with Logfire reporting disabled.
# LOGFIRE_TOKEN=
# Optional overrides:
# WAKE_WORD="hey mia"
# FUZZY_THRESHOLD=0.75
# Optional. Required to actually create Attendee bots, but the process
# starts fine without it.
# ATTENDEE_API_KEY=
# Optional. Defaults to http://localhost:8000.
# ATTENDEE_BASE_URL=http://localhost:8000
# Optional. Defaults to 8765.
# ATTENDEE_WEBSOCKET_PORT=8765
# Optional. Defaults to "Mia".
# ATTENDEE_BOT_NAME=Mia
